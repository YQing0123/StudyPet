{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banxue.local/schema/import-manifest/1.0.0",
  "title": "题库导入批次清单",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "created_by", "library_ref", "candidate_count"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "bundle_id": { "type": "string", "minLength": 6, "maxLength": 64 },
    "created_by": { "type": "string", "pattern": "^(agent|human):[A-Za-z0-9_.-]+$" },
    "library_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series", "level", "book"],
      "properties": {
        "series": { "type": "string", "minLength": 1 },
        "level":  { "type": "string", "minLength": 1 },
        "book":   { "type": "string", "minLength": 1 }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "prompt_version": { "type": "string" }
      }
    },
    "candidate_count": { "type": "integer", "minimum": 1, "maximum": 200 },
    "note": { "type": "string", "maxLength": 500 }
  }
}

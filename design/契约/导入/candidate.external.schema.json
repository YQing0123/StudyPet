{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banxue.local/schema/candidate-external/1.0.0",
  "title": "外部导入候选题（自然键形式）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_type", "question_family_key", "phase",
               "source_refs", "objective_refs", "skill", "modality", "difficulty",
               "estimated_seconds", "presentation_kind", "prompt_text", "instruction_text",
               "public_payload", "answer_spec", "explanation",
               "requires_microphone", "requires_typing", "quality_risks"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "question_family_key": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)+$" },
    "phase": { "enum": ["p1", "p2", "p3"] },
    "question_type": {
      "enum": ["sentence_choice","cloze_choice","cloze_text","word_order","matching",
               "word_to_picture","picture_to_word","audio_to_picture","reading_choice",
               "oral_reading","retell"]
    },
    "source_refs": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["page", "sentence_index"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "sentence_index": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "objective_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "skill": { "enum": ["listening","word_recognition","oral_reading","sentence_comprehension","spelling","oral_expression"] },
    "modality": { "enum": ["audio","visual","text","speech"] },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "estimated_seconds": { "type": "integer", "minimum": 5, "maximum": 180 },
    "presentation_kind": { "enum": ["verbatim", "variation", "transfer"] },
    "prompt_text": { "type": "string", "minLength": 1, "maxLength": 300 },
    "instruction_text": { "type": "string", "minLength": 1, "maxLength": 300 },
    "public_payload": { "type": "object" },
    "answer_spec": {
      "type": "object",
      "required": ["answer_kind"],
      "properties": { "answer_kind": { "enum": ["single_choice","multi_choice","ordered","text","speech"] } }
    },
    "explanation": { "type": "string", "maxLength": 600 },
    "requires_microphone": { "type": "boolean" },
    "requires_typing": { "type": "boolean" },
    "quality_risks": { "type": "array", "items": { "type": "string" } }
  }
}

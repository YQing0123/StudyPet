{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banxue:content:question-candidate:1.0.0",
  "title": "question-candidate",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "blueprint_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "phase": {
      "enum": [
        "p1",
        "p2"
      ]
    },
    "question_family_key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "question_type": {
      "enum": [
        "audio_to_picture",
        "word_to_picture",
        "picture_to_word",
        "oral_reading",
        "sentence_choice",
        "cloze_choice",
        "cloze_text",
        "matching",
        "word_order",
        "reading_choice",
        "retell"
      ]
    },
    "source_slice_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "context_slice_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true
    },
    "objective_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true
    },
    "skill": {
      "enum": [
        "listening",
        "word_recognition",
        "oral_reading",
        "sentence_comprehension",
        "spelling",
        "oral_expression"
      ]
    },
    "modality": {
      "enum": [
        "audio",
        "visual",
        "text",
        "speech"
      ]
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "estimated_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "presentation_kind": {
      "enum": [
        "verbatim",
        "paraphrase",
        "contextualized"
      ]
    },
    "prompt_text": {
      "type": "string",
      "minLength": 0,
      "maxLength": 3000
    },
    "instruction_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "public_payload": {
      "type": "object"
    },
    "answer_spec": {
      "type": "object"
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "requires_microphone": {
      "type": "boolean"
    },
    "requires_typing": {
      "type": "boolean"
    },
    "quality_risks": {
      "type": "array",
      "items": {
        "enum": [
          "ambiguous_answer",
          "context_missing",
          "source_uncertain",
          "media_uncertain",
          "scope_uncertain",
          "language_variant",
          "target_leakage",
          "open_response"
        ]
      },
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true
    },
    "source_quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slice_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "source_role": {
            "enum": [
              "assessed",
              "context",
              "distractor"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "start_char": {
            "type": "integer",
            "minimum": 0
          },
          "end_char": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "slice_id",
          "source_role",
          "quote",
          "start_char",
          "end_char"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "required": [
    "schema_version",
    "id",
    "blueprint_id",
    "phase",
    "question_family_key",
    "question_type",
    "source_slice_ids",
    "context_slice_ids",
    "objective_ids",
    "skill",
    "modality",
    "difficulty",
    "estimated_seconds",
    "presentation_kind",
    "prompt_text",
    "instruction_text",
    "public_payload",
    "answer_spec",
    "explanation",
    "requires_microphone",
    "requires_typing",
    "quality_risks",
    "source_quotes"

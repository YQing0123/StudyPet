# Copy to .env on the NAS; do not use app/data from your development machine.
BANXUE_IMAGE=banxue-island:2026.11.14-2027
BANXUE_BIND_IP=0.0.0.0
BANXUE_PORT=7788
BANXUE_DATA_PATH=/vol1/1000/banxue-island/data
# Check ownership and ACLs on the actual NAS directory before starting.
BANXUE_UID=1000
BANXUE_GID=1000
# User-configured HTTPS tunnel -> http://192.168.13.142:7788.
# Use this HTTPS origin for login (Secure cookies); omit the trailing slash.
# For an isolated LAN-only HTTP trial, explicitly clear this value.
BANXUE_PUBLIC_ORIGIN=https://studypet.iepose.cn
